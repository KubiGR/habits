# Optional. Copy to .env to override the defaults below.
DATABASE_URL=postgres://habits:habits@127.0.0.1:5436/habits
PORT=3001
HOST=127.0.0.1

# The person who manages account access. Habits from before there were people belong to them.
OWNER_EMAIL=owner@localhost
# Who you are in development, where there's no Cloudflare Access.
DEV_USER=owner@localhost

# Production: Cloudflare Access signs every request; the server checks the signature against these.
# ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# ACCESS_AUD=the Access application's audience tag
